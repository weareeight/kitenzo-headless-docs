---
// Site-map footer for the landing page, in the kitenzo.com footer style:
// hairline on top, wordmark + tagline, mono column headings, bottom bar.
import logo from '../assets/logo.png';

const cols = [
  {
    title: 'Get started',
    links: [
      { label: 'Overview', href: '/introduction/' },
      { label: 'Get access', href: '/getting-started/access/' },
      { label: 'Create an API key', href: '/getting-started/api-keys/' },
      { label: 'Quickstart', href: '/getting-started/quickstart/' },
    ],
  },
  {
    title: 'Integrate',
    links: [
      { label: 'Mode 1 — Embed', href: '/embed/' },
      { label: 'Mode 2 — SDK', href: '/sdk/' },
      { label: 'TapCart mobile apps', href: '/guides/tapcart/' },
      { label: 'Cart & discounts', href: '/guides/cart-discounts/' },
    ],
  },
  {
    title: 'Reference',
    links: [
      { label: 'API reference', href: '/api/' },
      { label: 'Endpoints', href: '/api/endpoints/' },
      { label: '@kitenzo/core', href: '/reference/core/' },
      { label: '@kitenzo/react', href: '/reference/react/' },
    ],
  },
  {
    title: 'Data & guides',
    links: [
      { label: 'Data you can pull', href: '/data/' },
      { label: 'Bundle types', href: '/data/bundle-types/' },
      { label: 'Shopify Hydrogen', href: '/guides/hydrogen/' },
      { label: 'Next.js', href: '/guides/nextjs/' },
    ],
  },
  {
    title: 'Kitenzo',
    links: [
      { label: 'kitenzo.com', href: 'https://kitenzo.com' },
      { label: 'For developers', href: 'https://kitenzo.com/developers' },
      { label: 'Help Center', href: 'https://support.kitenzo.com/' },
      { label: 'Support', href: '/resources/support/' },
    ],
  },
];
const year = new Date().getFullYear();
---
<footer class="kz-footer not-content">
  <div class="kz-container">
    <div class="kz-footer__cols">
      <div class="kz-footer__brand">
        <a href="/" title="Kitenzo Headless"><img src={logo.src} alt="Kitenzo" width="110" /></a>
        <p>The bundle commerce layer for Shopify — now for any storefront.</p>
      </div>
      {cols.map((col) => (
        <div>
          <h4>{col.title}</h4>
          <ul>
            {col.links.map((l) => (
              <li><a href={l.href}>{l.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="kz-footer__bottom">
      <span>© {year} Kitenzo Ltd. Headless is invite-only.</span>
      <a class="kz-nav-pill" href="mailto:support@kitenzo.com?subject=Kitenzo%20Headless%20access">Request access</a>
    </div>
  </div>
</footer>
