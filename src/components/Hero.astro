---
// Custom landing hero (overrides Starlight's Hero): mono kicker, two-tone
// headline, lead, pill CTAs, a mono meta strip, and the runtime visual.
import HeroVisual from './HeroVisual.astro';
const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
---
<section class="kz-hero">
  <div class="kz-hero-grid">
    <div class="kz-reveal">
      <p class="kz-kicker">Kitenzo Headless · API v1</p>
      <h1 id="_top" data-page-title class="kz-hero-title" set:html={title} />
      {tagline && <div class="kz-hero-lead" set:html={tagline} />}
      {actions.length > 0 && (
        <div class="kz-actions">
          {actions.map((a) => (
            <a
              class:list={['kz-btn', a.variant === 'primary' ? 'kz-btn--primary' : 'kz-btn--secondary']}
              href={typeof a.link === 'string' ? a.link : '#'}
            >
              {a.text}
            </a>
          ))}
        </div>
      )}
      <ul class="kz-meta">
        <li>REST API v1</li>
        <li>@kitenzo/react 0.4.0</li>
        <li>Shopify-native checkout</li>
        <li>Hydrogen · Next.js · TapCart</li>
      </ul>
    </div>
    <div class="kz-reveal" data-delay="1">
      <HeroVisual />
    </div>
  </div>
</section>
